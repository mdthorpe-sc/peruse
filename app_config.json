{
  "screenshot": {
    "default_width": 1920,
    "default_height": 1080,
    "page_load_timeout": 30000,
    "dynamic_content_wait": 2000,
    "default_extension": ".png",
    "full_page": true
  },
  "image_tiling": {
    "max_height_before_tiling": 4000,
